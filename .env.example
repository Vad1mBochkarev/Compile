# ============================================
# Compile — Переменные окружения
# ============================================
# Скопируйте этот файл в .env и заполните значения
# cp .env.example .env
# ============================================

# --- PostgreSQL ---
POSTGRES_USER=compile_user
POSTGRES_PASSWORD=compile_password
POSTGRES_DB=compile_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Строка подключения для backend (используется в SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://compile_user:compile_password@localhost:5432/compile_db

# --- MinIO (S3 Storage) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=compile
MINIO_SECURE=false

# --- JWT ---
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- SMTP (для отправки email) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@compile.local

# --- Frontend ---
VITE_API_URL=http://localhost:8000/api

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
